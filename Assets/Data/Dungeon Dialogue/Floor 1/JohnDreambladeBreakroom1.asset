    themeColor: {r: 0.94, g: 0.55, b: 0.75, a: 1}
    voiceBlip: {fileID: 8300000, guid: 8c15c351a579c37409198b65070fd741, type: 3}
  dialogueLines:
  - speakerIndex: 0
    text: what have you thought about the dungeon so far?
    autoProgress: 0
  - speakerIndex: 1
    text: its weird. i feel like there should be more people around.
    autoProgress: 0
  - speakerIndex: 0
    text: "more loot for us. i can\u2019t complain."
    autoProgress: 0
  - speakerIndex: 0
    text: oh wait I heard that youre working on a new comback. is it true?
    autoProgress: 0
  - speakerIndex: 1
    text: lol yeah but i cant say much yet. im under nda.
    autoProgress: 0
  - speakerIndex: 0
    text: aw cmon you can share a little bit you know how much of a huge fan i am
    autoProgress: 0
  - speakerIndex: 1
    text: idk :/
    autoProgress: 0
  - speakerIndex: 0
    text: plz  0_0
    autoProgress: 0
  - speakerIndex: 0
    text: ill trade you some loot.
    autoProgress: 0
  - speakerIndex: 1
    text: tempting but no sorry i have to keep my mouth shut. if my agents found
      out about it idk if i would have a job afterward.
    autoProgress: 0
  - speakerIndex: 0
    text: lame.
    autoProgress: 0
  - speakerIndex: 1
    text: dw when it releases we will have a listening party. I promise.
    autoProgress: 0
  - speakerIndex: 0
    text: "you better. i\u2019m basically your no1 fan."
    autoProgress: 0
  - speakerIndex: 1
    text: you might be but i know this one listener that has more hours listening
      to my music than my entire family. you would have to beat them.
    autoProgress: 0
  - speakerIndex: 0
    text: hehe i guess i will ;)
    autoProgress: 0
