%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b788e64e54c5a6546be5042a972358f3, type: 3}
  m_Name: Day1_Classroom
  m_EditorClassIdentifier: Assembly-CSharp::DialogueScript
  lines:
  - sender: {fileID: 11400000, guid: b3791e7d8a0e4f2b9c1d2e3f4a5b6c7d, type: 2}
    text: Salutations, Blythe, I can only assume you weren't paying attention to
      class again.
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: e1a2b3c4d5e6f70819203a4b5c6d7e83, type: 2}
    text: I was.
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: b3791e7d8a0e4f2b9c1d2e3f4a5b6c7d, type: 2}
    text: Oh, really? You've had your head in the clouds since the beginning of class,
      you have bags under your eyes, and you look as stiff as a board!
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: e1a2b3c4d5e6f70819203a4b5c6d7e83, type: 2}
    text: Why are you watching me? Shouldn't you be paying attention in class?
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: b3791e7d8a0e4f2b9c1d2e3f4a5b6c7d, type: 2}
    text: Well, I, uh, er....
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: b3791e7d8a0e4f2b9c1d2e3f4a5b6c7d, type: 2}
    text: That's not important! What's important is your education!
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: e1a2b3c4d5e6f70819203a4b5c6d7e83, type: 2}
    text: I'll keep that in mind.
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: b3791e7d8a0e4f2b9c1d2e3f4a5b6c7d, type: 2}
    text: Pfft, yeah right. You're probably thinking about stupid girl stuff like...
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: b3791e7d8a0e4f2b9c1d2e3f4a5b6c7d, type: 2}
    text: What do girls like?
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: e1a2b3c4d5e6f70819203a4b5c6d7e83, type: 2}
    text: You got this.
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: b3791e7d8a0e4f2b9c1d2e3f4a5b6c7d, type: 2}
    text: Ugh, never mind! Pay attention!
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: e1a2b3c4d5e6f70819203a4b5c6d7e83, type: 2}
    text: Thanks, B
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: e1a2b3c4d5e6f70819203a4b5c6d7e83, type: 2}
    text: ...
    delayBeforeMs: 800
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: e1a2b3c4d5e6f70819203a4b5c6d7e83, type: 2}
    text: Finally.
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: e1a2b3c4d5e6f70819203a4b5c6d7e83, type: 2}
    text: Just need to make it through the rest of the day.
    delayBeforeMs: 0
    typingDurationMs: 0
  - sender: {fileID: 11400000, guid: e1a2b3c4d5e6f70819203a4b5c6d7e83, type: 2}
    text: The dungeon drops tonight. I'm not missing it.
    delayBeforeMs: 600
    typingDurationMs: 0
